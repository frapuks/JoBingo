# Copier ce fichier en .env puis remplir les valeurs. Le .env n'est jamais commité.
# Il contient tous les secrets : le sauvegarder à part, en lieu sûr (voir README).

# --- Environnement --------------------------------------------------------------
# « development » en local, « production » sur le Pi.
# En production, le cookie de session porte l'attribut Secure : le navigateur ne
# l'accepte et ne le renvoie qu'en HTTPS, ce que fournit le proxy devant le Pi.
# En local l'app est servie en http (localhost, ou l'IP du PC depuis un téléphone) :
# avec Secure, le navigateur refuserait le cookie et on ne pourrait pas se connecter.
NODE_ENV=development

# Fuseau des horodatages (journaux, noms des sauvegardes).
TZ=Europe/Paris

# --- PostgreSQL -----------------------------------------------------------------
# Le port 5013 est publié : choisir un vrai mot de passe, surtout sur le Pi.
POSTGRES_USER=jobingo
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=jobingo

# --- Sessions -------------------------------------------------------------------
# Au moins 32 caractères aléatoires. Pour en générer un :
#   docker run --rm node:22-alpine node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Le changer déconnecte tous les utilisateurs.
JWT_SECRET=

# Adresse publique de l'app, utilisée dans le lien du mail « mot de passe oublié ».
# Sur le Pi : l'URL HTTPS servie par le proxy, par exemple https://jobingo.mondomaine.fr
APP_URL=http://localhost:6013

# --- E-mails (mot de passe oublié) ----------------------------------------------
# Laisser SMTP_HOST vide : aucun mail n'est envoyé, le lien de réinitialisation est
# écrit dans les journaux de l'API (npm run logs) pour être transmis à la main.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=JoBingo <jobingo@example.org>

# --- Notifications push (inactives tant que les clés sont vides) -----------------
# Génération (une seule fois !) :
#   docker compose exec api npx web-push generate-vapid-keys
# Sauvegarder ces clés avec le reste des secrets : les regénérer invalide tous les
# abonnements existants, chaque appareil devrait se réabonner.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact exigé par les services push (Apple, Google, Mozilla).
VAPID_SUBJECT=mailto:admin@example.org
